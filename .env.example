APP_NAME="King Vapezone"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://king-vapezone.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
